# Copy this file to .env for local Docker development. In Railway, add these as Variables.
APP_NAME=Bella AI Cloud
OPENROUTER_API_KEY=
MODEL_NAME=openai/gpt-4o-mini
MAX_TOKENS=80
WHISPER_MODEL=base
# Disable startup preload on Railway; local fallback remains lazy-loaded on demand.
WHISPER_PRELOAD_ENABLED=true
WHISPER_INTERIM_MODEL=tiny
# Set false to skip local interim CPU inference while retaining final cloud STT.
WHISPER_INTERIM_ENABLED=true
WHISPER_DEVICE=cpu
# Leave blank for English, Tamil, and Tanglish auto-detection. Set en or ta to force one language.
WHISPER_LANGUAGE=
WHISPER_FINAL_BEAM_SIZE=2
WHISPER_INTERIM_BEAM_SIZE=1
# Final STT runs through Whisper Large V3 Turbo. Tiny interim and Base final Whisper stay
# preloaded locally as the automatic fallback. Set either *_ENABLED=false to use
# the local provider directly.
OPENROUTER_STT_ENABLED=true
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
# Benchmark-only Tanglish candidate. Keep the main STT model above on Whisper Turbo.
OPENROUTER_TANGLISH_STT_MODEL=mistralai/voxtral-mini-transcribe
OPENROUTER_TTS_ENABLED=true
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
OPENROUTER_TTS_VOICE=af_bella
# Used by Bella's cute pet click messages.
OPENROUTER_TTS_CUTE_VOICE=af_bella
OPENROUTER_TIMEOUT_SECONDS=60
# Abort a slow Kokoro request and use Edge TTS instead.
OPENROUTER_TTS_TIMEOUT_SECONDS=8
# TTS_PROVIDER choices: kokoro (default) or edge (manual fallback-only mode).
TTS_PROVIDER=kokoro
# Start Kokoro and Edge together; select the first with two complete MP3 frames.
TTS_RACE_ENABLED=true
# First phrase target for streamed voice replies; allowed range is 4-8 words.
TTS_FIRST_CHUNK_WORDS=6
# Temporary local acceptance mode: one STT, one chat, one Kokoro phrase, zero Edge calls.
# This does not change defaults; disable after the single diagnostic turn.
VOICE_DIAGNOSTIC_MODE=false
# Separate opt-in for one full-response voice test; mutually exclusive with VOICE_DIAGNOSTIC_MODE.
BOUNDED_FULL_VOICE_TEST=false
# Female Edge backup used by the speed race and when Kokoro is unavailable.
TTS_VOICE=en-US-AnaNeural
PORT=8000
ENVIRONMENT=development
# Public deployments must set ENVIRONMENT=production and all three values below.
# Use a long unique password, a random signing secret (32+ characters), and exact
# browser origins such as https://bella.example (comma-separated if needed).
BELLA_ACCESS_PASSWORD=
BELLA_SESSION_SECRET=
BELLA_ALLOWED_ORIGINS=
BELLA_SESSION_TTL_SECONDS=86400
LOGIN_ATTEMPTS_PER_MINUTE=8
CHAT_REQUESTS_PER_MINUTE=20
STT_REQUESTS_PER_MINUTE=12
TTS_REQUESTS_PER_MINUTE=20
TALK_REQUESTS_PER_MINUTE=8
VOICE_REQUESTS_PER_MINUTE=10
MAX_CONCURRENT_PROVIDER_REQUESTS=4
MAX_ACTIVE_BROWSER_WEBSOCKETS=8
MAX_ACTIVE_RECORDINGS=2
MAX_ACTIVE_VOICE_TURNS=4
MAX_WS_AUDIO_FRAME_BYTES=65536
MAX_WS_RECORDING_BYTES=8388608
MAX_WS_RECORDING_SECONDS=30
MAX_HISTORY_MESSAGES=20
MAX_UPLOAD_BYTES=26214400
STORAGE_DIR=app/storage

# ESP32 device authentication. Replace this sample with a long random value.
# Format: device-id=token[,another-device-id=another-token]
BELLA_DEVICE_TOKENS=device-001=replace-with-a-random-32-byte-token
DEVICE_MAX_RECORDING_SECONDS=15
DEVICE_MAX_AUDIO_FRAME_BYTES=2048
DEVICE_MAX_IMAGE_BYTES=1000000

# Separate ESP32-CAM. Leave disabled until its board variant and sensor are verified.
BELLA_CAMERA_ENABLED=false
BELLA_CAMERA_BASE_URL=
BELLA_CAMERA_TOKEN=

# Reserved for Phase 2 memory adapters.
REDIS_URL=
POSTGRES_URL=
CHROMA_PATH=
